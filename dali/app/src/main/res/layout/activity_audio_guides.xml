<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCE5DE">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/audio_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Аудиогиды"
        app:titleTextColor="#FFFFFF" />

    <!-- Контент со скроллом -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Поиск -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:drawable/editbox_background"
                android:padding="8dp">

                <EditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Поиск аудиогидов"
                    android:inputType="text" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="43dp"
                    android:layout_marginStart="10dp"
                    android:src="@android:drawable/ic_menu_search" />
            </LinearLayout>

            <!-- Карточки аудиогидов -->
            <include layout="@layout/audio_card" />
            <include layout="@layout/audio_card1" />
            <include layout="@layout/audio_card2" />
            <include layout="@layout/audio_card3" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
