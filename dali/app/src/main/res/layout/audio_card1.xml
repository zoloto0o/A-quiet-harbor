<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="16dp"
    android:background="#DCE5DE"
    android:padding="12dp"
    android:elevation="2dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ico_audio_2"
        android:scaleType="centerCrop"
        android:background="@drawable/ico_audio_2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Покровская Заводь"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="лениво вьется тихая речушка, открывая вид на старинную церковь с золотым куполом. Ее отражение дрожит в воде, добавляя картине мистической красоты."
            android:textSize="14sp"
            android:textColor="#555"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ico_play"
        android:layout_gravity="center_vertical" />
</LinearLayout>
